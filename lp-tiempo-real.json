{
 "uid": "lp-tiempo-real",
 "title": "LOGISTPULSE · Monitoreo en tiempo real (streaming)",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "5s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "tags": [
  "logistpulse"
 ],
 "panels": [
  {
   "id": 1,
   "title": "Alertas últimos 10 min",
   "type": "stat",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "lp-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "lp-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COUNT(*) AS alertas FROM ods.alerts WHERE ts > now() - interval '10 minutes'"
    }
   ],
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    }
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "Vehículos reportando",
   "type": "stat",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "lp-pg"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "lp-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COUNT(DISTINCT vehicle_id) AS vehiculos FROM ods.amr_telemetry WHERE ts > now() - interval '30 seconds'"
    }
   ]
  },
  {
   "id": 3,
   "title": "Alertas recientes",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "lp-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "lp-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT ts, vehicle_id, alert_type, detail FROM ods.alerts ORDER BY ts DESC LIMIT 15"
    }
   ]
  },
  {
   "id": 4,
   "title": "Batería de los AMR (%)",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "lp-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "lp-pg"
     },
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT ts AS time, vehicle_id AS metric, battery_pct FROM ods.amr_telemetry WHERE $__timeFilter(ts) AND vehicle_id LIKE '%-AMR-%' ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Temperatura de la flota (°C)",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "lp-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "lp-pg"
     },
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT ts AS time, vehicle_id AS metric, temp_c FROM ods.amr_telemetry WHERE $__timeFilter(ts) ORDER BY 1"
    }
   ]
  },
  {
   "id": 6,
   "title": "Estado actual de la flota (mart_ops.fleet_health_now)",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "lp-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "lp-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT vehicle_id, status, speed_kmh, battery_pct, temp_c FROM mart_ops.fleet_health_now ORDER BY battery_pct"
    }
   ]
  }
 ]
}